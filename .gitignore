# ══════════════════════════════════════════════════════════════
# Sentinel — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Build output ──────────────────────────────────────────────
target/

# ── Challenge data (MUST NEVER enter Git) ─────────────────────
data/
/data/
*.parquet
*.xlsx

# Challenge CSVs in root/data are ignored, but test fixtures under src/ and submission artifact are allowed
*.csv
!src/test/resources/**
!predictions.csv
!/predictions.csv

# ── IDE files ─────────────────────────────────────────────────
.idea/
*.iml
*.iws
.project
.classpath
.settings/
.factorypath
.vscode/
*.code-workspace
.DS_Store
Thumbs.db

# ── OS / editor ──────────────────────────────────────────────
*~
*.swp
*.swo
*.bak

# ── Logs & Scratch ───────────────────────────────────────────
*.log
logs/
scratch/

# ── Environment / secrets ────────────────────────────────────
.env
*.env
